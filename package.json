{
  "name": "signalk-watchkeeper",
  "version": "0.2.0",
  "description": "Signal K plugin that watches every path, learns what is normal for this vessel, and raises notifications when a path departs from it",
  "license": "EUPL-1.2",
  "homepage": "https://github.com/KEGustafsson/signalk-watchkeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEGustafsson/signalk-watchkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-watchkeeper/issues"
  },
  "main": "index.cjs",
  "type": "module",
  "files": [
    "index.cjs",
    "lib",
    "public",
    "assets",
    "src",
    "test",
    "scripts",
    "docs",
    "tsconfig.json",
    "tsconfig.test.json",
    "CHANGELOG.md"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-embeddable-webapp",
    "signalk-category-notifications"
  ],
  "signalk": {
    "displayName": "Signal K Watchkeeper",
    "appIcon": "./assets/icons/icon-72x72.svg",
    "screenshots": [
      "./assets/screenshots/watchkeeper-panel.png"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "node scripts/clean.mjs",
    "postbuild": "node scripts/sync-public-assets.mjs",
    "prepack": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/smoke-test.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "preview:host": "node scripts/preview-host.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.9.4",
    "@types/node": "^22.19.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "KEGustafsson"
}
